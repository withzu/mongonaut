MONGO_CONNECTION_URL=""
MONGONAUT_READONLY=false
MONGONAUT_TIMEOUT=5000
MONGONAUT_QUERY_TIMEOUT=15000

DEV_REACTSCAN=false

# Authentication
# NONE | STATIC_PASSWORD | OIDC | ACCOUNT
MONGONAUT_AUTH_MODE=ACCOUNT
# Required when MONGONAUT_AUTH_MODE != NONE. At least 32 characters, shorter
# values are rejected. Generate one with: openssl rand -hex 32
MONGONAUT_AUTH_SECRET=""
# Session lifetime in seconds (default 86400 = 1 day)
MONGONAUT_SESSION_TTL=86400

# STATIC_PASSWORD
MONGONAUT_AUTH_PASSWORD=""

# Brute-force protection for STATIC_PASSWORD and ACCOUNT logins (per-IP and instance-wide)
MONGONAUT_LOGIN_MAX_ATTEMPTS=5
MONGONAUT_LOGIN_WINDOW_SECONDS=900
MONGONAUT_LOGIN_LOCKOUT_SECONDS=900
MONGONAUT_LOGIN_GLOBAL_MAX_ATTEMPTS=50
MONGONAUT_LOGIN_GLOBAL_WINDOW_SECONDS=300
# Number of trusted reverse proxies in front of Mongonaut. Only with a value of
# at least 1 is X-Forwarded-For used to identify clients for the per-IP limit,
# because any client can send that header itself. Set it to the number of
# proxies you control (1 for a single nginx, Traefik or Cloudflare Tunnel).
MONGONAUT_TRUSTED_PROXY_HOPS=0

# OIDC
MONGONAUT_OIDC_ISSUER=""
MONGONAUT_OIDC_CLIENT_ID=""
MONGONAUT_OIDC_CLIENT_SECRET=""
MONGONAUT_OIDC_SCOPES="openid profile email"
# Optional. If unset, derived from the incoming request as <origin>/api/auth/oidc/callback
MONGONAUT_OIDC_REDIRECT_URL=""
# Optional CSV allowlist. Empty = allow all authenticated identities. When set,
# the provider has to report the address as verified.
MONGONAUT_OIDC_ALLOWED_EMAILS=""

# ACCOUNT
# Optional: hidden internal database that stores accounts (default __mongonaut).
MONGONAUT_SYSTEM_DB="__mongonaut"
# Admin password recovery (ACCOUNT mode): run `pnpm recovery [email]` on the server
# to print a temporary one-time password to the console. Validity in minutes:
MONGONAUT_RECOVERY_TTL_MINUTES=30

# Limits
# Largest page size a user can request through the URL
MONGONAUT_MAX_PAGE_SIZE=200
# Maximum number of documents a single JSON export contains
MONGONAUT_EXPORT_MAX_DOCUMENTS=50000
# Maximum number of documents a single import inserts
MONGONAUT_IMPORT_MAX_DOCUMENTS=10000
# Allow $where, $function and $accumulator. These execute JavaScript inside
# MongoDB and let anyone with read access consume database CPU.
MONGONAUT_ALLOW_SERVER_JS=false

# Sidebar
# Per collection statistics cost one MongoDB command each. Turn them off, or
# lower the threshold, on instances with very many collections.
MONGONAUT_SIDEBAR_STATS=true
MONGONAUT_SIDEBAR_STATS_MAX_COLLECTIONS=100

# Audit
# Writes one JSON line per data or account change to stdout.
MONGONAUT_AUDIT_LOG=true
